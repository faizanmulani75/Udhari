// ============================================================
// Udhari SaaS — Prisma Schema
// Multi-tenant credit/debt management platform
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ========================
// ENUMS
// ========================

enum TransactionType {
  CREDIT
  DEBIT
  PAYMENT
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAST_DUE
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum ReminderChannel {
  SMS
  WHATSAPP
  EMAIL
}

// ========================
// 1. SHOPS
// ========================
// Root tenant table. Every other table references shopId.

model Shop {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(255)
  phone     String    @unique @db.VarChar(20)
  email     String?   @db.VarChar(255)
  address   String?   @db.Text
  city      String?   @db.VarChar(100)
  state     String?   @db.VarChar(100)
  pincode   String?   @db.VarChar(10)
  logoUrl   String?   @map("logo_url") @db.Text
  currency  String    @default("INR") @db.VarChar(10)
  upiId     String?   @map("upi_id") @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  users         User[]
  customers     Customer[]
  transactions  Transaction[]
  subscriptions Subscription[]
  reminders     Reminder[]

  @@index([phone])
  @@map("shops")
}

// ========================
// 2. USERS
// ========================
// Shopkeepers / staff who operate a shop.

model User {
  id           String    @id @default(uuid()) @db.Uuid
  shopId       String?   @map("shop_id") @db.Uuid
  authId       String    @unique @map("auth_id") @db.Uuid
  name         String    @db.VarChar(255)
  phone        String    @unique @db.VarChar(20)
  email        String?   @unique @db.VarChar(255)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  role         String    @default("owner") @db.VarChar(50)
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  shop                Shop?         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdTransactions Transaction[] @relation("TransactionCreator")
  createdReminders    Reminder[]    @relation("ReminderCreator")

  @@index([shopId])
  @@index([authId])
  @@map("users")
}

// ========================
// 3. CUSTOMERS
// ========================
// Customers who owe money to (or are owed by) a shop.

model Customer {
  id              String    @id @default(uuid()) @db.Uuid
  shopId          String    @map("shop_id") @db.Uuid
  name            String    @db.VarChar(255)
  phone           String    @db.VarChar(20)
  email           String?   @db.VarChar(255)
  address         String?   @db.Text
  notes           String?   @db.Text
  balance         Decimal   @default(0.00) @db.Decimal(12, 2)
  creditLimit     Decimal   @default(0.00) @map("credit_limit") @db.Decimal(12, 2)
  qrToken         String?   @unique @map("qr_token") @db.VarChar(255)
  qrTokenExpiresAt DateTime? @map("qr_token_expires_at") @db.Timestamptz
  reminderInterval String    @default("weekly") @map("reminder_interval") @db.VarChar(50)
  lastReminderAt   DateTime? @map("last_reminder_at") @db.Timestamptz
  isActive        Boolean   @default(true) @map("is_active")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  reminders    Reminder[]
  tags         CustomerTag[]

  @@unique([shopId, phone])
  @@index([shopId])
  @@index([qrToken])
  @@map("customers")
}

// ========================
// 4. TRANSACTIONS
// ========================
// Immutable ledger entries. Every credit, debit, or payment event.
// CREDIT  = customer owes more (shop gave goods on credit)
// DEBIT   = customer owes less (adjustment/return)
// PAYMENT = customer paid back

model Transaction {
  id              String          @id @default(uuid()) @db.Uuid
  shopId          String          @map("shop_id") @db.Uuid
  customerId      String          @map("customer_id") @db.Uuid
  type            TransactionType
  amount          Decimal         @db.Decimal(12, 2)
  balanceAfter    Decimal         @map("balance_after") @db.Decimal(12, 2)
  description     String?         @db.Text
  referenceNumber String?         @map("reference_number") @db.VarChar(100)
  paymentMethod   PaymentMethod?  @map("payment_method")
  transactionDate DateTime        @default(now()) @map("transaction_date") @db.Timestamptz
  createdBy       String?         @map("created_by") @db.Uuid
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz

  // No updatedAt — transactions are immutable ledger entries

  // Relations
  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  creator  User?    @relation("TransactionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  notes    TransactionNote[]

  @@index([shopId])
  @@index([customerId])
  @@index([shopId, customerId])
  @@index([shopId, transactionDate(sort: Desc)])
  @@index([shopId, type])
  @@map("transactions")
}

// ========================
// 5. SUBSCRIPTIONS
// ========================
// SaaS billing. Each shop has one active subscription at a time.

model Subscription {
  id            String             @id @default(uuid()) @db.Uuid
  shopId        String             @map("shop_id") @db.Uuid
  plan          SubscriptionPlan   @default(FREE)
  status        SubscriptionStatus @default(ACTIVE)
  maxCustomers  Int                @default(10) @map("max_customers")
  maxUsers      Int                @default(1) @map("max_users")
  amount        Decimal            @default(0.00) @db.Decimal(10, 2)
  currency      String             @default("INR") @db.VarChar(10)
  billingCycle  String             @default("monthly") @map("billing_cycle") @db.VarChar(20)
  startsAt      DateTime           @default(now()) @map("starts_at") @db.Timestamptz
  expiresAt     DateTime?          @map("expires_at") @db.Timestamptz
  cancelledAt   DateTime?          @map("cancelled_at") @db.Timestamptz
  deletedAt     DateTime?          @map("deleted_at") @db.Timestamptz
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, status])
  @@index([expiresAt])
  @@map("subscriptions")
}

// ========================
// 6. REMINDERS
// ========================
// Payment reminders sent to customers.

model Reminder {
  id           String          @id @default(uuid()) @db.Uuid
  shopId       String          @map("shop_id") @db.Uuid
  customerId   String          @map("customer_id") @db.Uuid
  channel      ReminderChannel @default(SMS)
  status       ReminderStatus  @default(PENDING)
  message      String          @db.Text
  amountDue    Decimal         @map("amount_due") @db.Decimal(12, 2)
  scheduledAt  DateTime        @default(now()) @map("scheduled_at") @db.Timestamptz
  sentAt       DateTime?       @map("sent_at") @db.Timestamptz
  failedReason String?         @map("failed_reason") @db.Text
  createdBy    String?         @map("created_by") @db.Uuid
  deletedAt    DateTime?       @map("deleted_at") @db.Timestamptz
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  creator  User?    @relation("ReminderCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([customerId])
  @@index([shopId, status])
  @@index([scheduledAt])
  @@map("reminders")
}

// ========================
// 7. AUDIT LOGS
// ========================
// Track backend/ledger operations by shopkeeper/staff.

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String   @db.VarChar(100) // e.g. "CREATE_TRANSACTION", "REVERSE_TRANSACTION"
  details   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([shopId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ========================
// 8. TAGS
// ========================
// Custom labels for categorizing customers (e.g. wholesale, retail, VIP).

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  name      String   @db.VarChar(50)
  color     String   @default("#6366F1") @db.VarChar(10) // Hex color for UI badges
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  customers CustomerTag[]

  @@unique([shopId, name])
  @@index([shopId])
  @@map("tags")
}

// ========================
// 9. CUSTOMER TAGS (Join Table)
// ========================

model CustomerTag {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([customerId, tagId])
  @@index([customerId])
  @@index([tagId])
  @@map("customer_tags")
}

// ========================
// 10. TRANSACTION NOTES
// ========================
// Threaded notes/comments on transactions for disputes, clarifications, etc.

model TransactionNote {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  shopId        String   @map("shop_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  content       String   @db.Text
  isDispute     Boolean  @default(false) @map("is_dispute")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([shopId])
  @@map("transaction_notes")
}

