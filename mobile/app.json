{
  "expo": {
    "name": "Udhari Tracker",
    "slug": "udhari-tracker",
    "scheme": "udhari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121217"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.udharitracker",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Udhari Khata needs speech recognition access to parse voice entry.",
        "NSMicrophoneUsageDescription": "Udhari Khata needs microphone access for voice entry of items."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121217",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.udharitracker",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Udhari Khata needs microphone access for voice entry of items.",
          "speechRecognitionPermission": "Udhari Khata needs speech recognition access to parse voice entry.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#121217",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "./withUpiQueries",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "1d1be6a8-4b7f-4e79-9599-863369e752fd"
      }
    },
    "owner": "faizanmulanis-team"
  }
}
